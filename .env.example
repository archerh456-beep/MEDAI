# =================================================================
# MedAI Academy - Environment Variables
# =================================================================

# 1. Neon PostgreSQL Connection URL
# Get this from your Neon Console (https://console.neon.tech)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-YOUR-PROJECT.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. Google OAuth / Identity Services (Optional for One-Tap)
NEXT_PUBLIC_GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"

# 3. App Secret
JWT_SECRET="medai_academy_secure_secret_2026"
